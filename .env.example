# Intermaptic environment variables
#
# Copy to `.env` (git-ignored) and fill in as needed. Every one of these is
# optional: with none of them set, the app builds and runs entirely on the atlas
# bundled into the frontend.

############################
# Frontend (Vite)
############################

# Where the API lives. Used by the frontend at build time, so it must be set on
# the build that deploys the site - not on the server.
#
#   https://intermaptic-api.vercel.app   the Vercel deployment of ./api
#   same-origin                          call /api on whatever host serves the page
#
# Leave it blank and the frontend never calls the API. It renders the bundled
# atlas instead and the HUD shows DATA: LOCAL.
VITE_API_BASE=

# Sub-path for GitHub Pages builds, e.g. /intermaptic/. Vercel builds use /.
VITE_BASE=/

############################
# Backend (Vercel functions in ./api)
############################

# Comma-separated list of origins allowed to call the API, e.g.
#   https://yourname.github.io,https://intermaptic.vercel.app
#
# Leave it unset and the API answers any origin, which is deliberate: it serves
# public read-only data. Set it to lock the API to just your own frontends.
ALLOWED_ORIGINS=
